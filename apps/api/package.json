{
  "name": "@stadiumlive/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
"db:migrate": "dotenv -e .env -- node-pg-migrate up -m migrations"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "firebase-admin": "^14.5.0",
    "helmet": "^8.1.0",
    "jose": "^6.2.12",
    "pg": "^8.23.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "dotenv-cli": "^11.0.0",
    "node-pg-migrate": "^9.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}